# Nom complet de l'image sur Docker Hub
IMAGE_NAME=brice99/zero-to-deploy

# Tag de l'image, aligne sur l'environnement (test / preprod / prod)
IMAGE_TAG=test

# Environnement charge par Spring (spring.profiles.active)
ENVIRONMENT=test

# Port expose sur l'hote (cote conteneur reste fixe a 8090)
HOST_PORT=3000

# Nom du conteneur Docker
CONTAINER_NAME=zero-to-deploy-test